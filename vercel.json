{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.canva.com https://canva.com https://*.canva.me;"
        },
        {
          "key": "X-Frame-Options",
          "value": "ALLOW-FROM https://www.canva.com/"
        }
      ]
    }
  ]
}
